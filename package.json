{
  "name": "dsh-redteam-asset-graph",
  "version": "7.9.5",
  "private": true,
  "license": "MIT",
  "description": "DSH 红队测试资产图谱：动态 Cordis 插件源码（src/）+ 常驻插件包（lib/）",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": {
      "default": "./lib/host.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "kind": "resident",
    "idPrefix": "asset",
    "dynamic": {
      "hostHalf": "src/host.js",
      "clientHalf": "src/client.js",
      "requires": [
        "Jina API Key（面板 设置 → Jina，必填）"
      ]
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "scripts": {
    "test": "node test/render-smoke.mjs",
    "build:lib": "node tools/build-lib.mjs"
  }
}
