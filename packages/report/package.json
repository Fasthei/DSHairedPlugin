{
  "name": "dsh-redteam-report",
  "version": "0.1.0",
  "private": true,
  "description": "DSH 红队报告插件：把资产图谱与研判结论汇成可交付的报告",
  "license": "MIT",
  "author": "fasthei",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fasthei/DSHairedPlugin.git",
    "directory": "packages/report"
  },
  "keywords": [
    "dsh",
    "cordis",
    "plugin",
    "redteam",
    "report"
  ],
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": {
      "default": "./lib/host.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "tools",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "dynamic": {
      "hostHalf": "src/host.js",
      "clientHalf": "src/client.js"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "scripts": {
    "build:lib": "node tools/build-lib.mjs",
    "check:lib": "node tools/build-lib.mjs --check",
    "prepack": "node tools/build-lib.mjs --check",
    "publish:gh": "node tools/prepare-gh-packages.mjs",
    "test": "node test/docx-smoke.mjs && node test/report-flow.mjs && node test/render-smoke.mjs",
    "test:docx": "node test/docx-smoke.mjs",
    "test:flow": "node test/report-flow.mjs",
    "test:render": "node test/render-smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
