{
  "name": "dsh-redteam-attack-matrix",
  "version": "1.0.0",
  "description": "DSH 红队攻击矩阵插件：扫工作区对话映射到 MITRE ATLAS / ATT&CK、OWASP LLM Top 10、NVIDIA AI Kill Chain 四套框架，标出已覆盖与缺口，并给出测试时间线",
  "license": "MIT",
  "author": "fasthei",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fasthei/DSHairedPlugin.git",
    "directory": "packages/attack-matrix"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "redteam",
    "attack-matrix",
    "mitre-atlas",
    "mitre-attack",
    "owasp-llm",
    "ai-security"
  ],
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": {
      "default": "./lib/host.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "tools",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "dynamic": {
      "hostHalf": "src/host.js",
      "clientHalf": "src/client.js"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "scripts": {
    "build:lib": "node tools/build-lib.mjs",
    "check:lib": "node tools/build-lib.mjs --check",
    "prepack": "node tools/build-lib.mjs --check",
    "publish:gh": "node tools/prepare-gh-packages.mjs",
    "test": "node test/scan-flow.mjs && node test/static-bundle-smoke.mjs",
    "test:scan": "node test/scan-flow.mjs",
    "test:static": "node test/static-bundle-smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
